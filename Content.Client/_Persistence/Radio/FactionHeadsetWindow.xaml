<DefaultWindow xmlns="https://spacestation14.io"
               MinSize="400 100"
               Title="{Loc 'faction-headset-window-title'}">
    <BoxContainer Orientation="Vertical">
        <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc 'faction-headset-window-transmit'}" StyleClasses="LabelKeyText" />
            <Control HorizontalExpand="True" />
            <OptionButton Name="TransmitOptions" />
        </BoxContainer>
        <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc 'faction-headset-window-receive'}" StyleClasses="LabelKeyText" />
            <Control HorizontalExpand="True" />
            <OptionButton Name="ReceiveOptions" />
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
