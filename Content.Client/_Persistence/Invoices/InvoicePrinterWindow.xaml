<DefaultWindow xmlns="https://spacestation14.io"
               MinSize="450 330">
    <BoxContainer Orientation="Vertical">
        <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc 'invoice-printer-window-id'}" />
            <Button Name="PrivilegedIdButton" Access="Public" />
        </BoxContainer>
        <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc 'invoice-printer-window-mode'}" StyleClasses="LabelKeyText" />
            <Control MinWidth="8" />
            <OptionButton Name="ModeOptions" HorizontalExpand="True" />
        </BoxContainer>
        <BoxContainer Name="FactionRow" Orientation="Horizontal">
            <Label Text="{Loc 'invoice-printer-window-faction'}" StyleClasses="LabelKeyText" />
            <Control MinWidth="8" />
            <OptionButton Name="FactionOptions" HorizontalExpand="True" />
        </BoxContainer>
        <Label Name="PayToLabel" />
        <Label Name="TaxLabel" />
        <Control MinHeight="8" />
        <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc 'invoice-printer-window-title'}" MinWidth="80" />
            <LineEdit Name="TitleEdit" HorizontalExpand="True" />
        </BoxContainer>
        <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc 'invoice-printer-window-amount'}" MinWidth="80" />
            <SpinBox Name="AmountSpinBox" HorizontalExpand="True" />
        </BoxContainer>
        <Label Text="{Loc 'invoice-printer-window-reason'}" />
        <LineEdit Name="ReasonEdit" HorizontalExpand="True" />
        <Control VerticalExpand="True" />
        <Button Name="PrintButton" Text="{Loc 'invoice-printer-window-print'}" />
    </BoxContainer>
</DefaultWindow>
