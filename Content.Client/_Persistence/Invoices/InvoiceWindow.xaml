<DefaultWindow xmlns="https://spacestation14.io"
               MinSize="380 260">
    <BoxContainer Orientation="Vertical">
        <Label Name="AmountLabel" StyleClasses="LabelKeyText" />
        <Label Name="PayToLabel" />
        <Label Name="TaxLabel" />
        <Control MinHeight="4" />
        <RichTextLabel Name="ReasonLabel" />
        <Control VerticalExpand="True" />
        <Label Name="PaidLabel" FontColorOverride="#50e050" />
        <BoxContainer Name="PaySection" Orientation="Vertical">
            <Label Name="CreditsLabel" />
            <BoxContainer Orientation="Horizontal">
                <OptionButton Name="PayFromOptions" HorizontalExpand="True" />
                <Button Name="PayButton" />
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
