<DefaultWindow xmlns="https://spacestation14.io"
               MinSize="400 150">
    <BoxContainer Orientation="Vertical">
        <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc 'grid-config-window-id'}" />
            <Button Name="PrivilegedIdButton" Access="Public" />
        </BoxContainer>
        <Control VerticalExpand="True" />
        <Label Name="OwnerLabel" />
        <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc 'station-creator-window-name'}" />
            <LineEdit Name="StationNameLineEdit" HorizontalExpand="True" />
        </BoxContainer>
        <Button Name="FinishButton" Text="{Loc 'station-creator-window-finish'}" />
    </BoxContainer>
</DefaultWindow>
