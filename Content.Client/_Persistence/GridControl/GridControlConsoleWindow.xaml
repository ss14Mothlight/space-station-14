<DefaultWindow xmlns="https://spacestation14.io"
               MinSize="300 120">
    <BoxContainer Orientation="Vertical">
        <Label Text="{Loc 'grid-control-console-window-description'}" />
        <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc 'grid-control-console-window-status'}" StyleClasses="LabelKeyText" />
            <Control HorizontalExpand="True" />
            <Button Name="OnButton" Text="{Loc 'grid-control-console-window-on'}" ToggleMode="True" />
            <Button Name="OffButton" Text="{Loc 'grid-control-console-window-off'}" ToggleMode="True" />
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
