<DefaultWindow xmlns="https://spacestation14.io"
               MinSize="420 260"
               Title="{Loc 'jobnet-window-title'}">
    <TabContainer Name="Tabs" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" Margin="8">
            <BoxContainer Orientation="Horizontal">
                <Label Text="{Loc 'jobnet-window-working-for'}" StyleClasses="LabelKeyText" />
                <Control MinWidth="8" />
                <OptionButton Name="StationOptions" HorizontalExpand="True" />
            </BoxContainer>
            <Label Name="NoFactionsLabel" Text="{Loc 'jobnet-window-no-factions'}" />
            <Control MinHeight="8" />
            <Label Name="AssignmentLabel" />
            <Label Name="WageLabel" />
            <Label Name="NextPayLabel" />
            <Label Name="SpendingLabel" />
        </BoxContainer>
        <BoxContainer Orientation="Vertical" Margin="8">
            <Label Name="BalanceLabel" />
            <Label Name="LevelLabel" />
            <Label Name="TileLimitLabel" />
            <Control MinHeight="8" />
            <Label Name="NextLevelLabel" />
            <Button Name="PurchaseButton" HorizontalAlignment="Left" />
        </BoxContainer>
    </TabContainer>
</DefaultWindow>
